{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/alfs",
      "destination": "/alfs/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/wp/:path*",
      "destination": "https://origin.stalineapen.uk/wp/:path*"
    },
    {
      "source": "/alfs/:path*",
      "destination": "https://origin.stalineapen.uk/alfs/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
